# Copy to .env (repo root) and adjust. Never commit .env.

# PostgreSQL (application database)
POSTGRES_USER=agera
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agera_symphony
POSTGRES_PORT=5432

# Keycloak database (separate DB in the same PostgreSQL instance)
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-too

# Keycloak bootstrap admin (master realm)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_PORT=8080

# Backend API (NestJS)
PORT=3000
# OpenAPI docs at /api/docs (default: on unless NODE_ENV=production)
SWAGGER_ENABLED=true
# Visit media storage: driver `local` writes below UPLOAD_DIR
# (in Docker, mount a volume at /uploads and set UPLOAD_DIR=/uploads)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# PostgreSQL connection used by the backend (least-privilege role created on first DB start)
DB_HOST=localhost
DB_PORT=5432
DB_USER=symphony_user
DB_PASSWORD=symphony_pass
DB_NAME=agera_symphony

# Keycloak IAM (JWT issuer + expected audience)
KEYCLOAK_REALM_URL=http://localhost:8080/realms/agera
KEYCLOAK_CLIENT_ID=agera-backend
# Enables People & access (user management through the agera-backend service account)
KEYCLOAK_CLIENT_SECRET=dev-backend-secret-change-me
# Optional: fetch signing keys from an internal URL (defaults to <realm URL>/protocol/openid-connect/certs)
# KEYCLOAK_JWKS_URL=http://keycloak:8080/auth/realms/agera/protocol/openid-connect/certs
# Optional: prefix all API routes (production uses API_PREFIX=api behind the reverse proxy)
# API_PREFIX=
