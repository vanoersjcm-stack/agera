# Agera Symphony - production configuration for a local Ubuntu server.
# Create .env.production with:  ./deploy.sh init-env https://symphony.example.lan
# (copies this file and replaces every __GENERATE__ with a random secret).
# Never commit .env.production. Secrets: at least 16 characters from A-Z a-z 0-9 . _ ~ -

# Address clients use to reach the server (https, host name or IP, ":port" only if HTTPS_PORT is not 443).
PUBLIC_URL=https://symphony.example.lan
HTTP_PORT=80
HTTPS_PORT=443

# Interactive API docs at /api/docs
SWAGGER_ENABLED=true

# PostgreSQL owner account (runs migrations; never used by the app)
POSTGRES_USER=agera
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_DB=agera_symphony

# Least-privilege account used by the backend (read/write data only, no schema changes)
DB_USER=symphony_app
DB_PASSWORD=__GENERATE__

# Keycloak's own database
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=__GENERATE__

# Temporary Keycloak administrator (master realm), created on first start
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__

# Secret of the `agera-backend` client in the `agera` realm
KEYCLOAK_CLIENT_SECRET=__GENERATE__
